void ataque(){
    // Se não tiver nenhuma arma equipada, não faz nada
    if (arma == 0) return;

    // Declaração das variáveis dos loops no topo para evitar o erro do C99
    int dx;
    int k;

    // Usamos a variável global 'condicao' que guarda a direção certa do jogador
    char direcao = condicao; 

    if (arma == 1){ // espada — ataca 3 células na frente
        int ax, ay;
        
        for (dx=-1; dx<=1; dx++){
            if (direcao=='^'){ ax=x+dx; ay=y-1; }
            else if (direcao=='v'){ ax=x+dx; ay=y+1; }
            else if (direcao=='>'){ ax=x+1;  ay=y+dx; }
            else if (direcao=='<'){ ax=x-1;  ay=y+dx; }
            else return;
            
            // Verifica os limites da matriz para não quebrar o jogo
            if (ax < 0 || ax >= 20 || ay < 0 || ay >= 20) continue;

            if (cenario1[ax][ay]=='x'){
                cenario1[ax][ay]=' ';
                // Manda o monstro para fora do mapa para sumir definitivamente
                xx=-1; yx=-1; 
                printf("\nNarrador: Uau. Teve sorte.\n");
                _getch(); // Pausa para ler a fala do narrador
            }
            else if (cenario1[ax][ay]=='y'){
                cenario1[ax][ay]=' ';
                // Manda o monstro para fora do mapa
                xy=-1; yy=-1; 
                printf("\nNarrador: Impressionante... de enojamento.\n");
                _getch();
            }
        }
    }

    else if (arma == 2){ // arco — projétil em linha reta até bater em algo
        int ax, ay;
        int adx=0, ady=0; // Renomeado para evitar conflito com o dx do topo

        if      (direcao=='^'){ adx=0;  ady=-1; }
        else if (direcao=='v'){ adx=0;  ady=1;  }
        else if (direcao=='>'){ adx=1;  ady=0;  }
        else if (direcao=='<'){ adx=-1; ady=0;  }
        else return;

        ax = x + adx;
        ay = y + ady;

        // Anda célula por célula até bater em uma parede ('*')
        while (cenario1[ax][ay] != '*'){
            if (cenario1[ax][ay]=='x'){
                cenario1[ax][ay]=' ';
                xx=-1; yx=-1; 
                printf("\nNarrador: Sorte de iniciante com arco...\n");
                _getch();
                return;
            }
            else if (cenario1[ax][ay]=='y'){
                cenario1[ax][ay]=' ';
                xy=-1; yy=-1; 
                printf("\nNarrador: Que tiro patético. Mas funcionou.\n");
                _getch();
                return;
            }
            ax += adx;
            ay += ady;
            
            // Segurança para evitar loop infinito fora da matriz
            if (ax < 0 || ax >= 20 || ay < 0 || ay >= 20) break;
        }
        // Chegou na parede sem acertar nada
        printf("\nNarrador: Errou tudo. Ate a parede riu.\n");
        _getch();
    }

    else if (arma == 3){ // cajado — ataca TODAS as 8 células ao redor
        int acertou = 0;

        int vizinhosx[] = {-1, -1, -1,  0,  0,  1,  1,  1};
        int vizinhosy[] = {-1,  0,  1, -1,  1, -1,  0,  1};

        for (k=0; k<8; k++){
            int ax = x + vizinhosx[k];
            int ay = y + vizinhosy[k];

            if (ax < 0 || ax >= 20 || ay < 0 || ay >= 20) continue;

            if (cenario1[ax][ay]=='x'){
                cenario1[ax][ay]=' ';
                xx=-1; yx=-1; 
                acertou=1;
            }
            else if (cenario1[ax][ay]=='y'){
                cenario1[ax][ay]=' ';
                xy=-1; yy=-1; 
                acertou=1;
            }
        }

        if (acertou){
            printf("\nNarrador: Cajado. A arma dos covardes que nao sabem mirar.\n");
        } else {
            printf("\nNarrador: Girou o cajado no ar como um idiota. Bonito.\n");
        }
        _getch();
    }
}

void acao(char key){
    switch(key)
    {
    case 's':
        if (cenario1[x][y+1]=='*'||cenario1[x][y+1]=='@'||cenario1[x][y+1]=='D'){
            return;
        }
        else if(cenario1[x][y+1]=='='){
            y++;
            condicao='v';
            system("cls");
            printf("\nNarrador: eu que deixei, ta?\n");
            _getch();
        }
        else {
            y++;
            condicao='v';
        }
        frentex=x;
        frentey=y+1; 
        condicaoMorte();
        break;
    case 'w':
        if (cenario1[x][y-1]=='*'||cenario1[x][y-1]=='@'||cenario1[x][y-1]=='D'||cenario1[x][y-1]=='='){
            return;
        }
        else if(cenario1[x][y-1]=='='){
            y--;
            condicao='^';
            system("cls");
            printf("\nNarrador: eu que deixei, ta?\n");
            _getch();
        }
        else {
            y--;
            condicao='^';
        }
        frentex=x;
        frentey=y-1; 
        condicaoMorte();
        break;
    case 'd':
        if (cenario1[x+1][y]=='*'||cenario1[x+1][y]=='@'||cenario1[x+1][y]=='D'||cenario1[x+1][y]=='='){
            return;
        }
        else if(cenario1[x+1][y]=='='){
            x++;
            condicao='>';
            system("cls");
            printf("\nNarrador: eu que deixei, ta?\n");
            _getch();
        }
        else {
            x++;
            condicao='>';
        }
        frentex=x+1;
        frentey=y;
        condicaoMorte();
        break;
    case 'a':
        if (cenario1[x-1][y]=='*'||cenario1[x-1][y]=='@'||cenario1[x-1][y]=='D'||cenario1[x-1][y]=='='){
            return;
        }
        else if(cenario1[x-1][y]=='='){
            x--;
            condicao='<';
            system("cls");
            printf("\nNarrador: eu que deixei, ta?\n");
            _getch();
        }
        else {
            x--;
            condicao='<'; 
        }
        frentex=x-1;
        frentey=y;
        condicaoMorte();
        break;

    case 'o':
        ataque();

    default:
        break;
    }
}

void bixo(){
    if (lugar == 1) return; 
    bixox= (rand()%4);
    condicaoMorte();
    switch(bixox){
    case 0:
        if (cenario1[xx][yx-1]=='*'||cenario1[xx][yx-1]=='#'||cenario1[xx][yx-1]=='@'||cenario1[xx][yx-1]=='D'||cenario1[xx][yx-1]=='='){
            yx++; return;
        }
        yx--; break;
    case 1:
        if (cenario1[xx][yx+1]=='*'||cenario1[xx][yx+1]=='#'||cenario1[xx][yx+1]=='@'||cenario1[xx][yx+1]=='D'||cenario1[xx][yx+1]=='='){
            yx--; return;
