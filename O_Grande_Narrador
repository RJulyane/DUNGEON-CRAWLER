void acao(char key){
    switch(key)
    {
    case 's':
        if (cenario1[x][y+1]=='*'||cenario1[x][y+1]=='@'||cenario1[x][y+1]=='D'){
            return;
        }
        else if(cenario1[x][y+1]=='='){
            y++;
            condicao='v';
            system("cls");
            printf("\nNarrador: eu que deixei, ta?\n");
            _getch();
        }
        else {
            y++;
            condicao='v';
        }
        frentex=x;
        frentey=y+1;
        condicaoMorte();
        break;
    case 'w':
        if (cenario1[x][y-1]=='*'||cenario1[x][y-1]=='@'||cenario1[x][y-1]=='D'||cenario1[x][y-1]=='='){
            return;
        }
        else {
            y--;
            condicao='^';
        }
        frentex=x;
        frentey=y-1;
        condicaoMorte();
        break;
    case 'd':
        if (cenario1[x+1][y]=='*'||cenario1[x+1][y]=='@'||cenario1[x+1][y]=='D'||cenario1[x+1][y]=='='){
            return;
        }
        else {
            x++;
            condicao='>';
        }
        frentex=x+1;
        frentey=y;
        condicaoMorte();
        break;
    case 'a':
        if (cenario1[x-1][y]=='*'||cenario1[x-1][y]=='@'||cenario1[x-1][y]=='D'||cenario1[x-1][y]=='='){
            return;
        }
        else {
            x--;
            condicao='<';
        }
        frentex=x-1;
        frentey=y;
        condicaoMorte();
        break;
    case 'o':
        ataque();
        break;
    default:
        break;
    }
}

void bixo(){
    if (lugar == 1 || lugar == 2) return;
    if (xx == -1 || yx == -1) return;
    bixox= (rand()%4);
    condicaoMorte();
    switch(bixox){
    case 0:
        if (cenario1[xx][yx-1]=='*'||cenario1[xx][yx-1]=='#'||cenario1[xx][yx-1]=='@'||cenario1[xx][yx-1]=='D'||cenario1[xx][yx-1]=='='){
            yx++; return;
        }
        yx--; break;
    case 1:
        if (cenario1[xx][yx+1]=='*'||cenario1[xx][yx+1]=='#'||cenario1[xx][yx+1]=='@'||cenario1[xx][yx+1]=='D'||cenario1[xx][yx+1]=='='){
            yx--; return;
        }
        yx++; break;
    case 2:
        if (cenario1[xx+1][yx]=='*'||cenario1[xx+1][yx]=='#'||cenario1[xx+1][yx]=='@'||cenario1[xx+1][yx]=='D'||cenario1[xx+1][yx]=='='){
            xx--; return;
        }
        xx++; break;
    default:
        if (cenario1[xx-1][yx]=='*'||cenario1[xx-1][yx]=='#'||cenario1[xx-1][yx]=='@'||cenario1[xx-1][yx]=='D'||cenario1[xx-1][yx]=='='){
            xx++; return;
        }
        xx--; break;
    }
    condicaoMorte();
}

void bixo2(){
    if (lugar == 1 || lugar == 2) return;
    if (xy == -1 || yy == -1) return;
    condicaoMorte();

    int tentativas = 0;
    while (tentativas < 5){
        if (cenario1[xy][yy+1]=='#'||cenario1[xy][yy+1]=='*'||cenario1[xy][yy+1]=='@'||cenario1[xy][yy+1]=='D'||cenario1[xy][yy+1]=='='){ yy--; tentativas++; continue; }
        if (cenario1[xy][yy-1]=='#'||cenario1[xy][yy-1]=='*'||cenario1[xy][yy-1]=='@'||cenario1[xy][yy-1]=='D'||cenario1[xy][yy-1]=='='){ yy++; tentativas++; continue; }
        if (cenario1[xy+1][yy]=='#'||cenario1[xy+1][yy]=='*'||cenario1[xy+1][yy]=='@'||cenario1[xy+1][yy]=='D'||cenario1[xy+1][yy]=='='){ xy--; tentativas++; continue; }
        if (cenario1[xy-1][yy]=='#'||cenario1[xy-1][yy]=='*'||cenario1[xy-1][yy]=='@'||cenario1[xy-1][yy]=='D'||cenario1[xy-1][yy]=='='){ xy++; tentativas++; continue; }

        if ( ( abs(xy - x) > abs(yy - y) ) && ( abs(xy-x) <= 3) ){
            if (xy < x) xy++; else xy--;
        }
        else {
            if (yy <= y) yy++; else yy--;
        }
        break;
    }
    condicaoMorte();
}

