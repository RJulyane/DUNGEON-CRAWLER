        yx++; break;
    case 2:
        if (cenario1[xx+1][yx]=='*'||cenario1[xx+1][yx]=='#'||cenario1[xx+1][yx]=='@'||cenario1[xx+1][yx]=='D'||cenario1[xx+1][yx]=='='){
            xx--; return;
        }
        xx++; break;
    default:
        if (cenario1[xx-1][yx]=='*'||cenario1[xx-1][yx]=='#'||cenario1[xx-1][yx]=='@'||cenario1[xx-1][yx]=='D'||cenario1[xx-1][yx]=='='){
            xx++; return;
        }
        xx--; break;  
    }
    condicaoMorte();
}

void bixo2(){
    if (lugar == 1) return; 
    condicaoMorte();
    bixoy= (rand()%2);
    
    while (1){
        if (cenario1[xy][yy+1] == '#' || cenario1[xy][yy+1] == '*'|| cenario1[xy][yy+1] == '@'|| cenario1[xy][yy+1] == 'D'|| cenario1[xy][yy+1] == '='){ yy--; continue; }
        if (cenario1[xy][yy-1] == '#' || cenario1[xy][yy-1] == '*'|| cenario1[xy][yy-1] == '@'|| cenario1[xy][yy-1] == 'D'|| cenario1[xy][yy-1] == '='){ yy++; continue; }
        if (cenario1[xy+1][yy] == '#' || cenario1[xy+1][yy] == '*'|| cenario1[xy+1][yy] == '@'|| cenario1[xy+1][yy] == 'D'|| cenario1[xy+1][yy] == '='){ xy--; continue; }
        if (cenario1[xy-1][yy] == '#' || cenario1[xy-1][yy] == '*'|| cenario1[xy-1][yy] == '@'|| cenario1[xy-1][yy] == 'D'|| cenario1[xy-1][yy] == '='){ xy++; continue; }
        
        if ( ( ( abs(xy - x) ) > ( abs(yy - y) ) ) && ( abs(xy-x) <= 3)) {
            if (xy < x) xy++; else xy--;
        }
        else {
            if (yy <= y) yy++; else yy--;
        }
        break;
    }
    condicaoMorte();
}
