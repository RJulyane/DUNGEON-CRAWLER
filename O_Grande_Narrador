void cenario(){
    // Limpa toda a matriz para evitar lixo de frames anteriores
    for (i=0; i<tamanhoc; i++){
        for (j=0; j<tamanhol; j++){
            cenario1[j][i]=' ';
        }
    }

    if (lugar==0){
        tamanhol=11;
        tamanhoc=11;
        
        // Reconstrói as paredes da Sala 0
        for (i=0; i<tamanhol; i++){
            for (j=0; j<tamanhoc; j++){
                if (i==0 || j==0 || i==tamanhol-1 || j==tamanhoc-1)
                    cenario1[j][i]='*';
            }
        }
        
        // Coloca os objetos fixos e itens (se ainda não foram pegos)
        cenario1[5][4]='#'; // Espinho
        if (chave == 0) cenario1[5][5]='@'; // Chave
        cenario1[10][2]='D'; // Porta
        
        // Insere as entidades móveis nas posições atuais
        cenario1[xx][yx]='x';
        cenario1[xy][yy]='y';
        cenario1[x][y]=condicao; // Desenha o jogador com a seta certa (^, v, <, >)
        
        // Imprime a Sala 0 na tela
        for (i=0;i<tamanhol;i++){
            for(j=0;j<tamanhoc;j++){
                printf("%c", cenario1[j][i]);
            }
            printf("\n");
        }
    }
    else if (lugar==1){
        tamanhol=9;
        tamanhoc=9;
        
        // Reconstrói as paredes da Sala 1
        for (i=0; i<tamanhol; i++){
            for (j=0; j<tamanhoc; j++){
                if (i==0 || j==0 || i==tamanhol-1 || j==tamanhoc-1)
                    cenario1[j][i]='*';
            }
        }
        
        // Insere apenas o jogador (monstros desativados nesta sala) e armas
        cenario1[x][y]=condicao;
        if (arma!=1){
            cenario1[4][2]='f';//espada
        }
        if (arma!=2){
            cenario1[6][2]='+';//flechas
        }
        if (arma!=3){
            cenario1[2][2]='i';//cajado
        }        
        cenario1[4][4]='V';//npc

        cenario1[4][1]='O';
               
        // Imprime a Sala 1 na tela
        for (i=0;i<tamanhol;i++){
            for(j=0;j<tamanhoc;j++){
                printf("%c", cenario1[j][i]);
            }
            printf("\n");
        }
    }
}

