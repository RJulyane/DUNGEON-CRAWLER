void acao(char key){
    switch(key)
    {
    case 's':
        if (cenario1[x][y+1]=='*'||cenario1[x][y+1]=='@'||cenario1[x][y+1]=='D'||cenario1[x][y+1]=='='){
            return;
        }
        cenario1[x][y]=' ';
        y++;
        cenario1[x][y]='v';
        frentex=x;
        frentey=y+1; 

        condicaoMorte();
        break;
    case 'w':
        if (cenario1[x][y-1]=='*'||cenario1[x][y-1]=='@'||cenario1[x][y-1]=='D'||cenario1[x][y-1]=='='){
            return;
        }
        cenario1[x][y]=' ';
        y--;
        cenario1[x][y]='^';

        frentex=x;
        frentey=y-1; 
        condicaoMorte();
        break;
    case 'd':
        if (cenario1[x+1][y]=='*'||cenario1[x+1][y]=='@'||cenario1[x+1][y]=='D'||cenario1[x+1][y]=='='){
            return;
        }
        cenario1[x][y]=' ';
        x++;
        cenario1[x][y]='>';
        frentex=x+1;
        frentey=y;
        condicaoMorte();
        break;
    case 'a':
        if (cenario1[x-1][y]=='*'||cenario1[x-1][y]=='@'||cenario1[x-1][y]=='D'||cenario1[x-1][y]=='='){
            return;
        }
        cenario1[x][y]=' ';
        x--;
        cenario1[x][y]='<'; 
        frentex=x-1;
        frentey=y;
        condicaoMorte();
        break;
    default:
        break;
    }
}

void bixo(){
    bixox= (rand()%4);
    cenario1[xx][yx]=' '; 
    condicaoMorte();
    switch(bixox){
    case 0:
        if (cenario1[xx][yx-1]=='*'||cenario1[xx][yx-1]=='#'||cenario1[xx][yx-1]=='@'||cenario1[xx][yx-1]=='D'||cenario1[xx][yx-1]=='='){
            yx++;
            cenario1[xx][yx]='x';
            return;
        }
        yx--;
        cenario1[xx][yx]='x';
        break;
    case 1:
        if (cenario1[xx][yx+1]=='*'||cenario1[xx][yx+1]=='#'||cenario1[xx][yx+1]=='@'||cenario1[xx][yx+1]=='D'||cenario1[xx][yx+1]=='='){
            yx--;
            cenario1[xx][yx]='x';
            return;
        }
        yx++;
        cenario1[xx][yx]='x';
        break;
    case 2:
        if (cenario1[xx+1][yx]=='*'||cenario1[xx+1][yx]=='#'||cenario1[xx+1][yx]=='@'||cenario1[xx+1][yx]=='D'||cenario1[xx+1][yx]=='='){
            xx--;
            cenario1[xx][yx]='x';
            return;
        }
        xx++;
        cenario1[xx][yx]='x';
        break;
    default:
        if (cenario1[xx-1][yx]=='*'||cenario1[xx-1][yx]=='#'||cenario1[xx-1][yx]=='@'||cenario1[xx-1][yx]=='D'||cenario1[xx-1][yx]=='='){
            xx++;
            cenario1[xx][yx]='x';
            return;
        }
        xx--;
        cenario1[xx][yx]='x';
        break;  
    }
    condicaoMorte();
}

void bixo2(){
    condicaoMorte();
    cenario1[xy][yy]=' ';
    bixoy= (rand()%2);
    
    while (1){
        if (cenario1[xy][yy+1] == '#' || cenario1[xy][yy+1] == '*'|| cenario1[xy][yy+1] == '@'|| cenario1[xy][yy+1] == 'D'|| cenario1[xy][yy+1] == '='){
            yy--;
            continue;
        }
        if (cenario1[xy][yy-1] == '#' || cenario1[xy][yy-1] == '*'|| cenario1[xy][yy-1] == '@'|| cenario1[xy][yy-1] == 'D'|| cenario1[xy][yy-1] == '='){
            yy++;
            continue;
        }
        if (cenario1[xy+1][yy] == '#' || cenario1[xy+1][yy] == '*'|| cenario1[xy+1][yy] == '@'|| cenario1[xy+1][yy] == 'D'|| cenario1[xy+1][yy] == '='){
            xy--;
            continue;
        }
        if (cenario1[xy-1][yy] == '#' || cenario1[xy-1][yy] == '*'|| cenario1[xy-1][yy] == '@'|| cenario1[xy-1][yy] == 'D'|| cenario1[xy-1][yy] == '='){
            xy++;
            continue;
        }
        
        if ( ( ( abs(xy - x) ) > ( abs(yy - y) ) ) && ( abs(xy-x) <= 3)) {
            if (xy < x) xy++;
            else xy--;
        }
        else {
            if (yy <= y) yy++;
            else yy--;
        }
        break;
    }
    cenario1[xy][yy] = 'y';
    condicaoMorte();
}

