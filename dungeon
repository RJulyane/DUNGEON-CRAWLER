void acao(char key){
	if ( ( cenario1[xx][yx] == '^') || ( cenario1[xx][yx] == 'v') || ( cenario1[xx][yx] == '<') || ( cenario1[xx][yx] == '>') ){
		vidas--;
		return;
	}
	if (cenario1[x][y] == 'x'){
		vidas--;
		return;
	}
	if (cenario1[x][y] == '#'){
		vidas--;
		return;
	}
	
	if (key== 's'){
		// fazer ele morrer se passar pelos espinhos, ou trocar por *
		if (cenario1[x][y+1]=='*'){
			return;
		}
		cenario1[x][y]=' ';
		y++;
		cenario1[x][y]='v';	
	}
	if (key== 'w'){
		if (cenario1[x][y-1]=='*'){
			return;
		}
		cenario1[x][y]=' ';
		y--;
		cenario1[x][y]='^';	
	}
	if (key== 'd'){
		if (cenario1[x+1][y]=='*'){
			return;
		}
		cenario1[x][y]=' ';
		x++;
		cenario1[x][y]='>';	
	}
	if (key== 'a'){
		if (cenario1[x-1][y]=='*'){
			return;
		}
		cenario1[x][y]=' ';
		x--;
		cenario1[x][y]='<';	
	}
}
void bixo(){
	bixox= (rand()%3)+1;
	cenario1[xx][yx]=' ';
	if (bixox==0){
		if (cenario1[xx][yx-1]=='*'){
			yx++;
			cenario1[xx][yx]='x';
			return;
		}
		yx--;
		cenario1[xx][yx]='x';
		// cima
	}
	else if (bixox==1){
		if (cenario1[xx][yx+1]=='*'){
			yx--;
			cenario1[xx][yx]='x';
			return;
		}
		yx++;
		cenario1[xx][yx]='x';
		// baixo
	}
	else if (bixox==2){
		if (cenario1[xx+1][yx]=='*'){
			xx--;
			cenario1[xx][yx]='x';
			return;
		}
		xx++;
		cenario1[xx][yx]='x';
		// direita
	}
	else{
		if (cenario1[xx-1][yx]=='*'){
			xx++;
			cenario1[xx][yx]='x';
			return;
		}
		xx--;
		cenario1[xx][yx]='x';
		// esquerda
	}
		
}
