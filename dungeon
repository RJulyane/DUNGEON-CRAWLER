#include <stdio.h>
#include <stdlib.h>
#include <conio.h>
#include <time.h>

int tamanhol=11;
int tamanhoc=11;

char cenario1[11][11];

int x=5, y=5;
int xx=9, yx=9, bixox;
int i, j;

void cenario(){
	for (i=0;i<tamanhol;i++){
		for(j=0;j<tamanhoc;j++){
			printf("%c", cenario1[j][i]);
		}
		printf("\n");
	}
}
void acao(char key){
	if (key== 's'){
		// fazer ele morrer se passar pelos espinhos, ou trocar por *
		if (cenario1[x][y+1]=='#'){
			return;
		}
		cenario1[x][y]=' ';
		y++;
		cenario1[x][y]='v';	
	}
	if (key== 'w'){
		if (cenario1[x][y-1]=='#'){
			return;
		}
		cenario1[x][y]=' ';
		y--;
		cenario1[x][y]='^';	
	}
	if (key== 'd'){
		if (cenario1[x+1][y]=='#'){
			return;
		}
		cenario1[x][y]=' ';
		x++;
		cenario1[x][y]='>';	
	}
	if (key== 'a'){
		if (cenario1[x-1][y]=='#'){
			return;
		}
		cenario1[x][y]=' ';
		x--;
		cenario1[x][y]='<';	
	}
}
void bixo(){
	bixox= (rand()%3)+1;
	if (bixox==0){
		cenario1[xx][yx]=' ';
		if (cenario1[xx][yx-1]=='#'){
			bixox= (rand()%3)+1;
		}
		yx--;
		cenario1[xx][yx]='x';
		// cima
	}
	else if (bixox==1){
		cenario1[xx][yx]=' ';
		if (cenario1[xx][yx+1]=='#'){
			bixox= (rand()%3)+1;
		}
		yx++;
		cenario1[xx][yx]='x';
		// baixo
	}
	else if (bixox==2){
		cenario1[xx][yx]=' ';
		if (cenario1[xx+1][yx]=='#'){
			bixox= (rand()%3)+1;
		}
		xx++;
		cenario1[xx][yx]='x';
		// direita
	}
	else{
		cenario1[xx][yx]=' ';
		if (cenario1[xx-1][yx]=='#'){
			bixox= (rand()%3)+1;
		}
		xx--;
		cenario1[xx][yx]='x';
		// esquerda
	}
		
}
int main(){
	srand(0);
	cenario1[xx][yx]='x';
	for (i=0;i<tamanhol;i++){
		for(j=0;j<tamanhoc;j++){
			if (i==tamanhol || j==tamanhoc){
				cenario1[j][i]='#';
			}
			else if( i==0 || j==0 || i==tamanhol-1 || j==tamanhoc-1){
				cenario1[j][i]='#';
			}
			else{
				cenario1[j][i]=' ';
			}
		}
	}
	
	while (1){
		if (_kbhit()){
			char key = _getch();
			
			if (key == 27) break;
			
			system("cls");
			acao(key);
			bixo();
			cenario();			
		}
	}
		
    return 0;
}
