void acao(char key){
	
	condicaoMorte();
	switch(key)
	{
	case 's':
		// fazer ele morrer se passar pelos espinhos, ou trocar por *
		if (cenario1[x][y+1]=='*'){
			return;
		}
		cenario1[x][y]=' ';
		y++;
		cenario1[x][y]='v';	
		break;
	case 'w':
		if (cenario1[x][y-1]=='*'){
			return;
		}
		cenario1[x][y]=' ';
		y--;
		cenario1[x][y]='^';	
		break;
	case 'd':
		if (cenario1[x+1][y]=='*'){
			return;
		}
		cenario1[x][y]=' ';
		x++;
		cenario1[x][y]='>';
		break;
	case 'a':
		if (cenario1[x-1][y]=='*'){
			return;
		}
		cenario1[x][y]=' ';
		x--;
		cenario1[x][y]='<';	
		break;
	default:
		break;
	}
	
}
